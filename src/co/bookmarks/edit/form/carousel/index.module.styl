.wrapper {
    position: relative
    width: 100%
    min-width: 0
    box-sizing: border-box
    margin-bottom: 8px
    background: rgba(0, 0, 0, 0.03)
    border: 1px solid var(--shadow-color)
    border-radius: var(--border-radius-medium, 10px)
    overflow: hidden
    user-select: none
    touch-action: pan-y
}

.header {
    display: flex
    align-items: center
    justify-content: space-between
    padding: 8px 12px
    font-size: 12px
    color: var(--secondary-text-color)
    border-bottom: 1px solid var(--shadow-color)
    background: rgba(0, 0, 0, 0.02)
}

.headerTitle {
    display: flex
    align-items: center
    gap: 6px
    font-weight: 600
    letter-spacing: 0.2px
}

.headerActions {
    display: flex
    align-items: center
    gap: 8px
}

.addBtn {
    background: none
    border: none
    color: var(--accent-color)
    cursor: pointer
    font-size: 12px
    font-weight: 600
    padding: 3px 8px
    border-radius: 4px
    display: flex
    align-items: center
    gap: 4px
    transition: background 0.15s, opacity 0.15s

    &:hover {
        background: rgba(0, 0, 0, 0.06)
    }
}

.badge {
    background: var(--accent-color)
    color: #fff
    font-size: 11px
    font-weight: 700
    padding: 2px 8px
    border-radius: 10px
    line-height: 1.3
}

.addForm {
    display: flex
    flex-direction: column
    gap: 6px
    padding: 10px 12px
    background: rgba(0, 0, 0, 0.03)
    border-bottom: 1px solid var(--shadow-color)
}

.addInputs {
    display: flex
    gap: 8px
    flex-wrap: wrap

    input {
        background: var(--background-color, #fff)
        border: 1px solid var(--shadow-color)
        border-radius: 5px
        padding: 6px 10px
        font-size: 12px
        color: var(--primary-text-color)
        outline: none
        box-sizing: border-box

        &:focus {
            border-color: var(--accent-color)
        }
    }

    .urlInput {
        flex: 1 1 200px
    }

    .captionInput {
        flex: 1 1 140px
    }
}

.addFormActions {
    display: flex
    justify-content: flex-end
    gap: 6px

    button {
        border: none
        border-radius: 4px
        padding: 5px 12px
        font-size: 11px
        font-weight: 600
        cursor: pointer
        transition: opacity 0.15s
    }

    .confirmAddBtn {
        background: var(--accent-color)
        color: #fff

        &:hover {
            opacity: 0.9
        }
    }

    .cancelAddBtn {
        background: transparent
        color: var(--secondary-text-color)

        &:hover {
            background: rgba(0, 0, 0, 0.05)
        }
    }
}

.sliderContainer {
    position: relative
    width: 100%
    height: 210px
    background: #0d0f14
    overflow: hidden
    cursor: grab

    &:active {
        cursor: grabbing
    }
}

.track {
    display: flex
    width: 100%
    height: 100%
    overflow-x: auto
    scroll-snap-type: x mandatory
    -webkit-overflow-scrolling: touch
    scrollbar-width: none

    &::-webkit-scrollbar {
        display: none
    }
}

.slide {
    flex: 0 0 100%
    min-width: 100%
    max-width: 100%
    height: 100%
    scroll-snap-align: start
    scroll-snap-stop: always
    position: relative
    display: flex
    align-items: center
    justify-content: center
    overflow: hidden
    box-sizing: border-box
}

.image {
    width: 100%
    height: 100%
    object-fit: contain
    display: block
    user-select: none
    -webkit-user-drag: none
    transition: transform 0.25s ease
}

.captionBar {
    position: absolute
    left: 0
    right: 0
    bottom: 0
    padding: 18px 12px 8px 12px
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 60%, transparent 100%)
    display: flex
    align-items: flex-end
    justify-content: space-between
    gap: 8px
    color: #fff
    z-index: 4
    pointer-events: auto
}

.captionTextGroup {
    display: flex
    flex-direction: column
    gap: 2px
    min-width: 0
    flex: 1
}

.captionTitle {
    font-size: 13px
    font-weight: 600
    line-height: 1.3
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
    text-shadow: 0 1px 2px rgba(0,0,0,0.8)
}

.captionSource {
    font-size: 10px
    text-transform: uppercase
    letter-spacing: 0.5px
    opacity: 0.75
}

.captionActions {
    display: flex
    align-items: center
    gap: 6px
    flex-shrink: 0
}

.captionEditBtn {
    background: rgba(255, 255, 255, 0.2)
    border: none
    color: #fff
    font-size: 11px
    padding: 3px 8px
    border-radius: 4px
    cursor: pointer
    transition: background 0.15s

    &:hover {
        background: rgba(255, 255, 255, 0.35)
    }
}

.zoomBtn {
    background: rgba(255, 255, 255, 0.2)
    border: none
    color: #fff
    font-size: 11px
    padding: 3px 8px
    border-radius: 4px
    cursor: pointer
    display: flex
    align-items: center
    gap: 4px
    transition: background 0.15s

    &:hover {
        background: rgba(255, 255, 255, 0.35)
    }
}

.captionEditor {
    position: absolute
    left: 8px
    right: 8px
    bottom: 8px
    background: rgba(18, 20, 30, 0.95)
    backdrop-filter: blur(8px)
    border: 1px solid rgba(255, 255, 255, 0.2)
    border-radius: 6px
    padding: 8px
    display: flex
    gap: 6px
    z-index: 10

    input {
        flex: 1
        background: rgba(255, 255, 255, 0.1)
        border: 1px solid rgba(255, 255, 255, 0.2)
        border-radius: 4px
        padding: 4px 8px
        font-size: 12px
        color: #fff
        outline: none

        &:focus {
            border-color: var(--accent-color)
        }
    }

    button {
        border: none
        border-radius: 4px
        padding: 4px 10px
        font-size: 11px
        font-weight: 600
        cursor: pointer
    }

    .saveCaptionBtn {
        background: var(--accent-color)
        color: #fff
    }

    .cancelCaptionBtn {
        background: rgba(255, 255, 255, 0.15)
        color: #fff
    }
}

.navButton {
    position: absolute
    top: 50%
    transform: translateY(-50%)
    background: rgba(0, 0, 0, 0.55)
    color: #fff
    border: 1px solid rgba(255, 255, 255, 0.2)
    width: 34px
    height: 34px
    border-radius: 50%
    display: flex
    align-items: center
    justify-content: center
    cursor: pointer
    font-size: 18px
    z-index: 6
    backdrop-filter: blur(4px)
    transition: background 0.15s, transform 0.15s, opacity 0.15s
    opacity: 0.9

    &:hover {
        background: rgba(0, 0, 0, 0.85)
        transform: translateY(-50%) scale(1.08)
        opacity: 1
    }

    &:active {
        transform: translateY(-50%) scale(0.94)
    }
}

.prevButton {
    left: 8px
}

.nextButton {
    right: 8px
}

.footer {
    display: flex
    align-items: center
    justify-content: center
    gap: 6px
    padding: 8px
    background: rgba(0, 0, 0, 0.02)
}

.dot {
    width: 6px
    height: 6px
    border-radius: 50%
    background: var(--disable-text-color)
    border: none
    padding: 0
    cursor: pointer
    transition: width 0.2s, background 0.2s, border-radius 0.2s

    &:hover {
        background: var(--secondary-text-color)
    }
}

.activeDot {
    width: 18px
    border-radius: 4px
    background: var(--accent-color)
}
