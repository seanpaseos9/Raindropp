.overlay {
    position: fixed
    top: 0
    left: 0
    right: 0
    bottom: 0
    z-index: 999999
    background: rgba(12, 14, 28, 0.96)
    backdrop-filter: blur(8px)
    display: flex
    flex-direction: column
    color: #fff
    user-select: none
    touch-action: none
    animation: fadeIn 0.18s ease-out
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.topbar {
    display: flex
    align-items: center
    justify-content: space-between
    padding: 12px 16px
    background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent)
    z-index: 10
}

.titleArea {
    display: flex
    align-items: center
    gap: 12px
    min-width: 0
}

.counter {
    background: rgba(255, 255, 255, 0.15)
    padding: 3px 10px
    border-radius: 12px
    font-size: 13px
    font-weight: 600
    letter-spacing: 0.5px
}

.alt {
    font-size: 13px
    opacity: 0.85
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
    max-width: 320px
}

.actions {
    display: flex
    align-items: center
    gap: 8px
}

.toolButton {
    background: rgba(255, 255, 255, 0.12)
    border: none
    color: #fff
    cursor: pointer
    border-radius: 8px
    padding: 6px 10px
    font-size: 13px
    font-weight: 500
    display: inline-flex
    align-items: center
    justify-content: center
    transition: background 0.15s, transform 0.1s
    text-decoration: none

    &:hover {
        background: rgba(255, 255, 255, 0.22)
    }

    &:active {
        transform: scale(0.96)
    }
}

.closeButton {
    background: rgba(255, 255, 255, 0.18)
    border: none
    color: #fff
    cursor: pointer
    border-radius: 50%
    width: 36px
    height: 36px
    font-size: 18px
    line-height: 1
    display: flex
    align-items: center
    justify-content: center
    transition: background 0.15s, transform 0.1s

    &:hover {
        background: rgba(255, 255, 255, 0.3)
    }

    &:active {
        transform: scale(0.94)
    }
}

.body {
    flex: 1
    position: relative
    display: flex
    align-items: center
    justify-content: center
    overflow: hidden
}

.stage {
    width: 100%
    height: 100%
    display: flex
    align-items: center
    justify-content: center
    cursor: grab

    &:active {
        cursor: grabbing
    }
}

.image {
    max-width: 92%
    max-height: 86vh
    object-fit: contain
    border-radius: 4px
    box-shadow: 0 10px 40px rgba(0,0,0,0.5)
    transition: transform 0.15s cubic-bezier(0.2, 0, 0.2, 1)
    pointer-events: auto
}

.navPrev, .navNext {
    position: absolute
    top: 50%
    transform: translateY(-50%)
    background: rgba(20, 20, 30, 0.6)
    border: 1px solid rgba(255, 255, 255, 0.15)
    color: #fff
    width: 44px
    height: 44px
    border-radius: 50%
    display: flex
    align-items: center
    justify-content: center
    cursor: pointer
    font-size: 20px
    z-index: 10
    transition: background 0.15s, transform 0.15s

    &:hover {
        background: rgba(255, 255, 255, 0.25)
        transform: translateY(-50%) scale(1.08)
    }

    &:active {
        transform: translateY(-50%) scale(0.95)
    }
}

.navPrev {
    left: 16px
}

.navNext {
    right: 16px
}

.bottombar {
    display: flex
    align-items: center
    justify-content: center
    gap: 8px
    padding: 12px 16px
    background: linear-gradient(to top, rgba(0,0,0,0.6), transparent)
    z-index: 10
}

.zoomBadge {
    font-size: 12px
    background: rgba(255, 255, 255, 0.15)
    padding: 3px 8px
    border-radius: 6px
}
