.overlay {
    position: fixed
    top: 0
    left: 0
    right: 0
    bottom: 0
    z-index: 999999
    background: var(--background-color, #fff)
    display: flex
    flex-direction: column
    color: var(--primary-text-color, #222)
    user-select: none
    touch-action: none
    animation: fadeIn 0.18s ease-out
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.topbar {
    display: flex
    align-items: center
    justify-content: space-between
    padding: calc(12px + env(safe-area-inset-top)) 16px 12px
    background: var(--background-color, #fff)
    z-index: 10
}

.titleArea {
    display: flex
    align-items: center
    gap: 12px
    min-width: 0
}

.counter {
    background: rgba(0, 0, 0, 0.08)
    padding: 3px 10px
    border-radius: 12px
    font-size: 13px
    font-weight: 600
    letter-spacing: 0.5px
}

.alt {
    font-size: 13px
    opacity: 0.85
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
    max-width: 320px
}

.inlineEditBtn {
    background: none
    border: none
    color: var(--accent-color)
    opacity: 0.7
    cursor: pointer
    padding: 2px 6px
    font-size: 13px
    transition: opacity 0.15s, transform 0.1s

    &:hover {
        opacity: 1
        transform: scale(1.15)
    }
}

.lightboxCaptionForm {
    display: flex
    align-items: center
    gap: 6px

    input {
        background: var(--background-secondary, #f5f5f5)
        border: 1px solid var(--shadow-color, #ddd)
        border-radius: 6px
        padding: 4px 8px
        font-size: 13px
        color: var(--primary-text-color, #222)
        outline: none
        min-width: 180px

        &:focus {
            border-color: var(--accent-color)
        }
    }

    button {
        border: none
        border-radius: 4px
        padding: 4px 8px
        font-size: 12px
        font-weight: 600
        cursor: pointer
    }

    .captionSaveBtn {
        background: var(--accent-color)
        color: #fff
    }

    .captionCancelBtn {
        background: rgba(0, 0, 0, 0.08)
        color: var(--primary-text-color, #222)
    }
}

.actions {
    display: flex
    align-items: center
    gap: 8px
}

.toolButton {
    background: rgba(0, 0, 0, 0.08)
    border: none
    color: var(--primary-text-color, #222)
    cursor: pointer
    border-radius: 8px
    padding: 6px 10px
    font-size: 13px
    font-weight: 500
    display: inline-flex
    align-items: center
    justify-content: center
    transition: background 0.15s, transform 0.1s
    text-decoration: none

    &:hover {
        background: rgba(0, 0, 0, 0.14)
    }

    &:active {
        transform: scale(0.96)
    }
}

.closeButton {
    background: rgba(0, 0, 0, 0.08)
    border: none
    color: var(--primary-text-color, #222)
    cursor: pointer
    border-radius: 50%
    width: 36px
    height: 36px
    font-size: 18px
    line-height: 1
    display: flex
    align-items: center
    justify-content: center
    transition: background 0.15s, transform 0.1s

    &:hover {
        background: rgba(0, 0, 0, 0.14)
    }

    &:active {
        transform: scale(0.94)
    }
}

.body {
    flex: 1
    position: relative
    display: flex
    align-items: center
    justify-content: center
    overflow: hidden
}

.stage {
    width: 100%
    height: 100%
    min-height: 0
    padding: 0
    display: flex
    align-items: center
    justify-content: center
    cursor: grab

    &:active {
        cursor: grabbing
    }
}

.image {
    width: auto
    height: auto
    max-width: 100vw
    max-height: 100%
    object-fit: contain
    border-radius: 0
    box-shadow: none
    transition: transform 0.15s cubic-bezier(0.2, 0, 0.2, 1)
    pointer-events: auto
}

.navPrev, .navNext {
    position: absolute
    top: 50%
    transform: translateY(-50%)
    background: rgba(0, 0, 0, 0.08)
    border: 1px solid var(--shadow-color, #ddd)
    color: var(--primary-text-color, #222)
    width: 44px
    height: 44px
    border-radius: 50%
    display: flex
    align-items: center
    justify-content: center
    cursor: pointer
    font-size: 20px
    z-index: 10
    transition: background 0.15s, transform 0.15s

    &:hover {
        background: rgba(0, 0, 0, 0.14)
        transform: translateY(-50%) scale(1.08)
    }

    &:active {
        transform: translateY(-50%) scale(0.95)
    }
}

.navPrev {
    left: 16px
}

.navNext {
    right: 16px
}

.bottombar {
    display: flex
    align-items: center
    justify-content: center
    gap: 8px
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom))
    background: var(--background-color, #fff)
    z-index: 10
}

.zoomBadge {
    font-size: 12px
    background: rgba(0, 0, 0, 0.08)
    padding: 3px 8px
    border-radius: 6px
}
