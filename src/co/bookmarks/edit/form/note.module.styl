.note {
    position: relative
    width: 100%
}

.button {
    position: absolute
    right: var(--padding-micro)
    bottom: var(--padding-micro)
    --primary-text-color: var(--disable-text-color)
}

.noteContainer {
    display: flex
    flex-direction: column
    gap: 6px
    width: 100%
    min-width: 0
    box-sizing: border-box
}

.topBar {
    display: flex
    align-items: center
    justify-content: flex-end
    gap: 12px
    font-size: 11px
    min-height: 18px
}

.actionBtn {
    background: none
    border: none
    color: var(--accent-color)
    cursor: pointer
    padding: 2px 4px
    font-size: 11px
    font-weight: 600
    display: inline-flex
    align-items: center
    gap: 4px
    border-radius: 4px
    transition: background 0.15s, opacity 0.15s

    &:hover {
        background: rgba(0, 0, 0, 0.05)
        text-decoration: underline
    }
}

.cleanNoteCard {
    background: rgba(0, 0, 0, 0.02)
    border: 1px solid var(--shadow-color)
    border-radius: var(--border-radius-small, 6px)
    padding: 10px 12px
    font-size: 13px
    line-height: 1.5
    position: relative
    cursor: text
    min-height: 40px
    color: var(--primary-text-color)
    transition: background 0.15s, border-color 0.15s
    box-sizing: border-box

    &:hover {
        background: rgba(0, 0, 0, 0.04)
        border-color: var(--accent-color)
    }
}

.cleanTextContent {
    word-break: break-word
    white-space: pre-wrap
    font-size: 13px
    line-height: 1.45
    color: var(--primary-text-color)
}

.emptyCleanText {
    color: var(--disable-text-color)
    font-style: italic
    font-size: 12px
}

.collapsedBanner {
    display: flex
    align-items: center
    justify-content: space-between
    font-size: 11px
    color: var(--secondary-text-color)
    margin-top: 8px
    padding-top: 6px
    border-top: 1px dashed var(--shadow-color)
}

.inlineEditBtn {
    color: var(--accent-color)
    font-weight: 500
    font-size: 11px
}