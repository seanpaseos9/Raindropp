.article, .embed {
    display: block
    width: 100%
    height: 100%
    border: 0
    box-shadow: none
    background: transparent
}

.preloader {
    position: absolute
    left: 0
    right: 0
    top: auto !important;
    display: flex
    align-items: center
    justify-content: center
    pointer-events: none
    animation: fadeIn .4s ease-in-out
}

@keyframes fadeIn {
    0% {opacity: 0}
    100% {opacity: 1}
}

.imageViewer {
    display: flex
    flex-direction: column
    width: 100%
    height: 100%
    position: relative
    background: var(--background-secondary, rgba(0,0,0,0.03))
    overflow: hidden
    touch-action: none
}

.imageStage {
    flex: 1
    display: flex
    align-items: center
    justify-content: center
    overflow: auto
    padding: 20px
    touch-action: none
}

.previewImage {
    max-width: 100%
    max-height: 100%
    object-fit: contain
    border-radius: var(--border-radius, 8px)
    box-shadow: 0 4px 20px rgba(0,0,0,0.15)
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1)
}

.toolbar {
    position: absolute
    bottom: 16px
    left: 50%
    transform: translateX(-50%)
    display: flex
    align-items: center
    gap: 8px
    padding: 6px 14px
    background: var(--background-color, #fff)
    box-shadow: 0 2px 14px rgba(0,0,0,0.18)
    border-radius: 20px
    z-index: 10
}

.toolBtn {
    appearance: none
    background: transparent
    border: none
    cursor: pointer
    padding: 4px 8px
    border-radius: 4px
    font-size: 13px
    color: var(--primary-text-color)
    transition: background-color 0.15s ease

    &:hover {
        background-color: var(--hover-background-color)
    }
}

.zoomText {
    font-size: 12px
    font-weight: 600
    color: var(--secondary-text-color)
    min-width: 40px
    text-align: center
}